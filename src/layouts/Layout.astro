---
import '../styles/global.css';
import { pathFor } from '../lib/urls';
import { safeJson } from '../lib/urls';
import { shops } from '../lib/catalogue';
interface Props { title?:string; description?:string; }
const { title='深圳美食指南',description='从高德扫街榜整理深圳美食门店，公开收录依据、综合评分方法与资料缺口。找店、收藏、地图导航。' } = Astro.props;
const canonical = new URL(Astro.url.pathname,Astro.site);
const active = Astro.url.pathname;
---
<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <title>{title === '深圳美食指南' ? title : `${title} · 深圳美食指南`}</title>
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href={pathFor('favicon.svg')} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={new URL(pathFor('og.svg'),Astro.site).href} />
    <meta name="theme-color" content="#f6f2e9" />
  </head>
  <body>
    <a class="skip-link" href="#main">跳到正文</a>
    <header class="header">
      <div class="shell header-inner">
        <a class="brand" href={pathFor()} aria-label="深圳美食指南首页"><span class="brand-seal" aria-hidden="true">食</span><span>深圳美食指南<small>SHENZHEN FOOD GUIDE</small></span></a>
        <nav aria-label="主导航">
          <a href={pathFor()} aria-current={active === pathFor() ? 'page':undefined}>找美食</a>
          <a href={pathFor('favorites/')} aria-current={active.includes('/favorites') ? 'page':undefined}>我的收藏 <span class="nav-count" data-favorite-count>0</span></a>
          <a href={pathFor('methodology/')} aria-current={active.includes('/methodology') ? 'page':undefined}>整理原则</a>
        </nav>
      </div>
    </header>
    <main id="main"><slot /></main>
    <footer class="footer shell">
      <div><strong>深圳美食指南</strong><p>慢慢找店，好好吃饭。只用高德资料，保留核验依据。</p><p>独立整理，与高德地图无官方关联。到店前请确认门店及营业情况。</p></div>
      <div class="footer-links"><a href={pathFor('methodology/')}>评分与收录标准</a><a href={pathFor('status/')}>资料状态与纠错</a><span>收藏存于本机 · 无访客追踪</span></div>
    </footer>
    <div class="toast" id="toast" role="status" aria-live="polite" hidden></div>
    <script type="application/json" id="favorite-known-ids" set:html={safeJson(shops.map(s=>s.id))} />
    <script>import '../scripts/global.ts';</script>
  </body>
</html>

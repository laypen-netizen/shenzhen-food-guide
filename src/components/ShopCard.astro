---
import type { Shop } from '../lib/schema';
import { ageAt,repeatVisitsDisplay } from '../lib/schema';
import { navigationUrl } from '../lib/geo';
import { pathFor } from '../lib/urls';
import { catalogue,recommendationById } from '../lib/catalogue';
interface Props { shop:Shop; }
const {shop} = Astro.props;
const rating = [...shop.ratings].sort((a,b) => b.asOf.localeCompare(a.asOf))[0];
const age = ageAt(shop,shop.checkedAt);
const recommendation = recommendationById.get(shop.id);
const recommendationScore = recommendation?.score != null ? String(recommendation.score):null;
const recommendationRank = recommendation?.eligible && recommendation.rank != null ? `参评组${recommendation.tied ? '并列':''}第${recommendation.rank}/${recommendation.sampleSize}`:null;
const recommendationReason = recommendation?.reason ? `${recommendation.reason.split(/[。；]/)[0]}。`:'缺少同组可比较的评分与回访双证据。';
const knownDishes = shop.dishes.slice(0,2).map(dish=>dish.text).join(' · ');
const poiSourceIds = new Set([
  ...shop.address.sourceIds,
  ...shop.operating.sourceIds,
  ...(shop.hours?.sourceIds ?? []),
  ...(shop.coordinates?.sourceIds ?? []),
  ...shop.ratings.flatMap(item=>item.sourceIds),
]);
const amapShopPage = catalogue.sources.find(source=>source.kind==='poi' && poiSourceIds.has(source.id));
const amapShopPageIsDirect = amapShopPage ? (()=>{const url=new URL(amapShopPage.url);return url.pathname.includes('/place/') || url.pathname.includes('/poi_detail') || url.searchParams.has('id');})():false;
const amapPhotoLabel = amapShopPageIsDirect ? '在高德查看实拍':'去高德找店和照片';
---
<article class="shop-card" data-shop-card data-shop-id={shop.id}>
  {shop.photos[0] ? <a class="card-image" href={pathFor(`shops/${shop.slug}/`)} tabindex="-1" aria-hidden="true"><img src={pathFor(shop.photos[0].path)} alt="" width="640" height="420" loading="lazy" /><span class="card-age">{age === null ? '高德扫街榜':'至少 ' + age + ' 年'}</span></a> : <div class="card-image is-placeholder"><div class="photo-placeholder"><span class="photo-glyph" aria-hidden="true">食</span><span>暂无授权实拍</span></div>{amapShopPage&&<a class="amap-photo-link" href={amapShopPage.url} target="_blank" rel="noopener noreferrer" aria-label={`${amapPhotoLabel}：${shop.name}`}>{amapPhotoLabel} <span aria-hidden="true">↗</span></a>}<span class="card-age">{age === null ? '高德扫街榜':'至少 ' + age + ' 年'}</span></div>}
  <div class="card-body">
    <div class="eyebrow">{shop.district} · {shop.category}</div>
    <h3><a href={pathFor(`shops/${shop.slug}/`)}>{shop.name}</a></h3>
    <p class="card-address">{shop.address.text}</p>
    {knownDishes&&<p class="card-dishes"><strong>可以留意</strong>{knownDishes}</p>}
    <div class:list={['dual-card',{unrated:!recommendation?.eligible}]}>{recommendation?.eligible ? <><div class="dual-rank"><span>本站双证据参考</span><strong>{recommendationRank}</strong></div><div class="dual-score"><span>参考分</span><strong>{recommendationScore}<small>/100</small></strong></div></>:<div class="dual-unrated"><span>本站双证据参考</span><strong>未参评</strong><small>{recommendationReason}</small></div>}</div>
    <p class="score-disclaimer">{recommendation?.eligible ? `双项领先 ${recommendation.leadCount} 家 · 持平 ${recommendation.tieCount} 家${recommendation.score===0 ? ' · 0分表示当前组内未共同领先，不代表差评':''} · 非高德官方排名`:'未参评不等于低分，也不生成名次。'}</p>
    <div class="card-facts"><span>{shop.price ? `参考人均 ¥${shop.price.cny} · ${shop.price.asOf}`:'人均待核验'}</span><span>{shop.repeatVisits ? `近${shop.repeatVisits.windowDays}天 ${repeatVisitsDisplay(shop.repeatVisits)} 回头客 · 高德页面`:'未取得高德回头客人数'}</span><span>{rating ? `高德 ${rating.value}${rating.max ? `/${rating.max}`:'（量表待核验）'}${rating.count !== null ? ` · ${rating.count.toLocaleString('zh-CN')} 条评价`:''} · ${rating.asOf}`:'暂无可核验评分'}</span></div>
    <p class="source-line">营业线索截至 {shop.operating.asOf} · <a href={pathFor(`shops/${shop.slug}/#sources`)}>查看依据</a></p>
    <div class="card-actions"><button type="button" class="favorite-button" data-favorite={shop.id} aria-pressed="false" disabled aria-label={`收藏${shop.name}`}><span aria-hidden="true">♡</span> 收藏</button><a class="text-action" href={navigationUrl(shop)} target="_blank" rel="noopener noreferrer">{shop.coordinates ? '高德导航':'高德查地址'} <span aria-hidden="true">↗</span></a></div>
  </div>
</article>

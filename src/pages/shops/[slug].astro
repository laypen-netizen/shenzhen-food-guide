---
import Layout from '../../layouts/Layout.astro';
import ShopCard from '../../components/ShopCard.astro';
import {catalogue,ratingById,shops} from '../../lib/catalogue';
import {ageAt,repeatVisitsDisplay} from '../../lib/schema';
import type {Shop} from '../../lib/schema';
import {gcjToWgs,navigationUrl,straightDistance} from '../../lib/geo';
import {pathFor,safeJson} from '../../lib/urls';
import {getRankingYears} from '../../lib/amap-rating';
export function getStaticPaths() { return shops.map(shop=>({params:{slug:shop.slug},props:{shop}})); }
interface Props { shop:Shop; }
const {shop}=Astro.props;
const rating=ratingById.get(shop.id)??null;
const rankingYears=getRankingYears(shop);
const age=ageAt(shop,shop.checkedAt);
const sources=catalogue.sources.filter(s=>JSON.stringify(shop).includes(`"${s.id}"`));
const reference=(ids:readonly string[])=>ids.map(id=>sources.find(s=>s.id===id)).filter(Boolean);
const amapShopPage=sources.find(source=>source.kind==='poi' && shop.address.sourceIds.includes(source.id)) ?? sources.find(source=>source.kind==='poi');
const amapShopPageIsDirect=amapShopPage ? (()=>{const url=new URL(amapShopPage.url);return url.pathname.includes('/place/') || url.pathname.includes('/poi_detail') || url.searchParams.has('id');})():false;
const amapPhotoLabel=amapShopPageIsDirect ? '在高德查看实拍':'去高德找店和照片';
const nearby=shops.filter(s=>s.id!==shop.id && (shop.coordinates ? s.coordinates:s.district===shop.district)).map(s=>{
  let distance:number|null=null;
  if(shop.coordinates && s.coordinates) distance=straightDistance(...gcjToWgs(shop.coordinates.lon,shop.coordinates.lat),...gcjToWgs(s.coordinates.lon,s.coordinates.lat));
  return {shop:s,distance};
}).sort((a,b)=>(a.distance??0)-(b.distance??0)).slice(0,3);
const jsonLd={ '@context':'https://schema.org','@type':'Restaurant',name:shop.name,address:{'@type':'PostalAddress',streetAddress:shop.address.text,addressLocality:'深圳',addressRegion:'广东',addressCountry:'CN'},servesCuisine:shop.cuisine,url:new URL(pathFor(`shops/${shop.slug}/`),Astro.site).href };
---
<Layout title={shop.name} description={shop.summary.text}>
  <div class="shell detail-header"><a class="breadcrumb" href={pathFor(`?district=${encodeURIComponent(shop.district)}#find`)}>← {shop.district}美食</a><div class="eyebrow">{shop.district} · {shop.category}{shop.history&&age!==null ? ` · 具体门店至少${age}年`:''}</div><h1>{shop.name}</h1>{rankingYears.length>0&&<div class="ranking-year-tags detail-ranking-years" aria-label="高德上榜年份">{rankingYears.map(year=><a href="#sources">{year} 上榜</a>)}</div>}<p>{shop.summary.text}</p><p class="detail-quick-facts"><strong>{shop.price ? `参考人均 ¥${shop.price.cny}` : '人均待核验'}</strong><span>{shop.hours?.text??'营业时间待核验'}</span></p><div class="detail-actions"><button class="button button-outline favorite-button" type="button" data-favorite={shop.id} aria-pressed="false" aria-label={`收藏${shop.name}`} disabled>♡ 收藏</button><a class="button button-primary" href={navigationUrl(shop)} target="_blank" rel="noopener noreferrer">{shop.coordinates ? '高德导航':'高德查地址'} ↗</a><button class="text-button" data-copy="url" type="button">复制分享链接</button></div><nav class="detail-jumps" aria-label="本页内容"><a href="#dishes">菜品</a><a href="#recommendation">高德评分</a><a href="#visit">出发信息</a></nav></div>
  <div class="shell detail-layout"><div class="detail-main">
    {shop.photos.length ? <section class="detail-photo">{shop.photos.map(p=><figure><img src={pathFor(p.path)} alt={p.alt} width="1000" height="660" loading="lazy" /><figcaption>{p.author} · <a href={p.sourceUrl} target="_blank" rel="noopener noreferrer">图片来源</a> · {p.permission}</figcaption></figure>)}</section>:amapShopPage&&<section class="detail-photo-entry"><a href={amapShopPage.url} target="_blank" rel="noopener noreferrer">{amapPhotoLabel} <span aria-hidden="true">↗</span></a><small>{amapShopPageIsDirect ? '照片在高德门店页查看':'先在高德搜索并确认这家店'}</small></section>}
    <section class="detail-section" id="dishes"><h2>可以留意这些菜</h2><div class="dish-list">{shop.dishes.map(d=><div><strong>{d.text}</strong>{reference(d.sourceIds).map(s=>s&&<a class="source-ref" href={`#source-${s.id}`}>依据 ↗</a>)}</div>)}</div>{!shop.dishes.length && <p>招牌菜暂无可核验资料。</p>}</section>
    <section class="detail-section amap-rating-detail" id="recommendation">
      <div class="rating-heading">
        <div><div class="eyebrow">AMAP RATING</div><h2>高德评分</h2></div>
        {rating ? <div class="amap-rating-value"><span>页面原始评分</span><strong>{rating.value}</strong></div>:<strong class="rating-missing">暂无可核验评分</strong>}
      </div>
      {rating ? <div class="rating-detail-facts"><p><strong>{rating.count !== null ? `${rating.count.toLocaleString('zh-CN')} 条评价`:'评价数未公布'}</strong><span>采集日期 {rating.asOf}</span></p>{rating.max !== null&&<p>高德来源记录的量表上限为 {rating.max}；本站不另行推测或换算。</p>}{reference(rating.sourceIds).map(s=>s&&<a class="source-ref" href={`#source-${s.id}`}>{s.title} ↗</a>)}</div>:<p>当前没有可核验的高德餐厅评分记录。</p>}
      <div class="amap-repeat-fact"><h3>高德回访信息</h3>{shop.repeatVisits ? <><p>高德页面显示近 {shop.repeatVisits.windowDays} 天 {repeatVisitsDisplay(shop.repeatVisits)} 位回头客，采集日期 {shop.repeatVisits.asOf}。这是平台展示值，不是真实客流或回头率。</p>{reference(shop.repeatVisits.sourceIds).map(s=>s&&<a class="source-ref" href={`#source-${s.id}`}>{s.title} ↗</a>)}</>:<p>尚未取得高德页面的回头客人数；这不表示该店没有回头客。</p>}</div>
      {amapShopPage&&<a class="button button-outline rating-source-button" href={amapShopPage.url} target="_blank" rel="noopener noreferrer">{amapShopPageIsDirect ? '打开高德门店原页':'在高德搜索这家店'} ↗</a>}
      <p class="help-text">本站直接展示采集到的高德原始字段，不换算成百分制，也不将其标为高德官方排名。</p>
    </section>
    <section class="detail-section"><h2>为什么整理这家店</h2><p class="help-text">以下根据高德资料整理，不是本站到访体验。</p><ul class="reason-list">{shop.reasons.map(r=><li><p>{r.text}</p>{reference(r.sourceIds).map(s=>s&&<a class="source-ref" href={`#source-${s.id}`}>{s.title} ↗</a>)}</li>)}</ul></section>
    {shop.history&&<section class="detail-section"><h2>门店历史</h2><p>{shop.history.description}</p><p>具体门店最晚开业日期：{shop.history.latestOpeningDate}。{age === null ? '经营延续未明，暂不计算店龄':`截至 ${shop.checkedAt} 至少 ${age} 年`}；经营延续{shop.history.continuation === 'verified' ? '已核验':'尚不确定'}。</p>{shop.history.brandDescription&&<p>品牌背景：{shop.history.brandDescription}（不用于替代分店年龄）。</p>}{reference(shop.history.sourceIds).map(s=>s&&<a class="source-ref" href={`#source-${s.id}`}>{s.title} ↗</a>)}</section>}
    <section class="detail-section" id="sources"><h2>来源及原始榜单</h2><p>年份、原始指标和榜单页面名次保留在下方供核查；它们与当前高德评分一起按原始字段展示，不作百分制换算。资料核验日 {shop.checkedAt}，访问来源不等于确认今天营业。</p><details class="raw-evidence"><summary>查看高德原始评分、回访证据与榜单记录</summary><div><h3>高德评分与回访证据</h3>{shop.repeatVisits ? <p>高德页面显示近 {shop.repeatVisits.windowDays} 天 {repeatVisitsDisplay(shop.repeatVisits)} 位回头客，依据日期 {shop.repeatVisits.asOf}。平台口径：{shop.repeatVisits.definition}。该人数不直接换算成回头率。{reference(shop.repeatVisits.sourceIds).map(s=>s&&<a class="source-ref" href={`#source-${s.id}`}>回头客依据 ↗</a>)}</p>:<p>尚未取得高德页面的回头客人数；这不表示该店没有回头客。</p>}{shop.ratings.map(r=><p>高德原始评分 {r.value}{r.max ? `/${r.max}`:'（满分量表待核验）'}，评价数量 {r.count??'未公布'}，采集日期 {r.asOf}。{reference(r.sourceIds).map(s=>s&&<a class="source-ref" href={`#source-${s.id}`}>评分来源 ↗</a>)}</p>)}{!shop.ratings.length&&<p>暂无可核验原始评分。</p>}<h3>高德原始榜单</h3>{shop.rankings.map(r=><p>{r.name} · {r.edition} · {r.scope}{r.rank ? ` · 页面第${r.rank}名`:''}{r.annualHeat ? ` · 高德${r.annualHeat.year}原榜“${r.annualHeat.label}” ${r.annualHeat.rawDisplay??r.annualHeat.value} · 非评分`:''}{r.annualCompositeScore ? r.annualCompositeScore.year===null ? ` · 高德原榜“${r.annualCompositeScore.label}” ${r.annualCompositeScore.rawDisplay??r.annualCompositeScore.value} · 年份未注明`:` · 高德${r.annualCompositeScore.year}原榜“${r.annualCompositeScore.label}” ${r.annualCompositeScore.rawDisplay??r.annualCompositeScore.value}`:''} · 依据日期 {r.asOf}{reference(r.sourceIds).map(s=>s&&<a class="source-ref" href={`#source-${s.id}`}>上榜依据 ↗</a>)}</p>)}</div></details><h3>逐条来源记录</h3><ol class="source-list">{sources.map(s=><li id={`source-${s.id}`}><details><summary><span>{s.title}</span><small>访问日 {s.accessedAt}</small></summary><div class="source-detail"><a href={s.url} target="_blank" rel="noopener noreferrer">打开高德来源 ↗</a><p>{s.statement}</p>{s.capture && <p>App观察路径：{s.capture.view}</p>}<small>发布日 {s.publishedAt??'未公布'} · 访问日 {s.accessedAt}</small></div></details></li>)}</ol></section>
  </div><aside class="visit-panel" id="visit"><div class="eyebrow">BEFORE YOU GO</div><h2>出发前看一眼</h2><dl><dt>地址</dt><dd>{shop.address.text}</dd><dt>参考人均</dt><dd>{shop.price ? `¥${shop.price.cny} · ${shop.price.asOf}`:'暂无可核验价格'}</dd><dt>营业时间</dt><dd>{shop.hours?.text??'暂无可核验时间'}</dd>{shop.scenes.length>0&&<><dt>适合的场景</dt><dd>{shop.scenes.join(' · ')}</dd></>}</dl><button class="button button-outline" type="button" data-copy={shop.address.text}>复制地址</button><a class="button button-primary" href={navigationUrl(shop)} target="_blank" rel="noopener noreferrer">{shop.coordinates ? '打开高德导航':'在高德搜索地址'} ↗</a><details class="visit-evidence"><summary>查看营业依据与出发提醒</summary><div><p>营业线索截至 {shop.operating.asOf}。{shop.operating.note}</p>{reference(shop.operating.sourceIds).map(s=>s&&<a class="source-ref" href={`#source-${s.id}`}>营业依据 ↗</a>)}<p>地址、价格和营业时间均按高德来源整理，请出发前再次核对。</p>{reference(shop.address.sourceIds).map(s=>s&&<a class="source-ref" href={`#source-${s.id}`}>地址依据 ↗</a>)}{shop.price&&reference(shop.price.sourceIds).map(s=>s&&<a class="source-ref" href={`#source-${s.id}`}>价格依据 ↗</a>)}{shop.hours&&reference(shop.hours.sourceIds).map(s=>s&&<a class="source-ref" href={`#source-${s.id}`}>时间依据 ↗</a>)}{shop.coordinates&&<p class="help-text">导航使用高德 GCJ-02 坐标；全站地图转换为 WGS-84 展示。</p>}{shop.cautions.length>0&&<div class="visit-cautions"><h3>注意事项</h3>{shop.cautions.map(c=><p>{c.text}{reference(c.sourceIds).map(s=>s&&<a class="source-ref" href={`#source-${s.id}`}>依据 ↗</a>)}</p>)}</div>}</div></details><a class="text-action" href={pathFor('status/')}>纠错与补充资料 ↗</a></aside></div>
  {nearby.length>0&&<section class="shell nearby"><div class="section-heading"><h2>{shop.coordinates ? '附近的已收录门店':'同区的已收录门店'}</h2><span>{shop.coordinates ? '直线距离，不代表步行距离':'暂无可靠坐标，不按距离推荐'}</span></div><div class="shop-grid">{nearby.map(n=><div>{n.distance!==null&&<p class="distance">直线距离 {n.distance.toFixed(1)} km</p>}<ShopCard shop={n.shop}/></div>)}</div></section>}
  <script type="application/ld+json" set:html={safeJson(jsonLd)} />
</Layout>

---
import Layout from '../layouts/Layout.astro';
import Catalog from '../components/Catalog.astro';
import {catalogue,shops} from '../lib/catalogue';
import {districts} from '../lib/schema';
import {pathFor} from '../lib/urls';
---
<Layout>
  <section class="hero shell">
    <div class="hero-copy"><div class="eyebrow"><span class="tiny-dot"></span> 高德数据 · 本站综合整理</div><h1>同一把尺，<br />找出<span>更值得去</span>的小店。</h1><p>口碑 45% · 榜单 35% · 回访证据 20%。<br />统一选集排名，公开分项、资料缺口和来源。</p><a class="button button-primary" href="#find">查看综合推荐榜 <span aria-hidden="true">↓</span></a><a class="hero-secondary" href={pathFor('methodology/')}>评分怎样算 ↗</a></div>
    <div class="hero-art"><img src={pathFor('street.svg')} alt="街边小店主题插画，非真实门店照片" width="560" height="330" /><span class="art-caption">街角有烟火，常来有理由。<small>主题插画 · 非门店实拍</small></span></div>
  </section>
  <section class="stat-bar shell" aria-label="资料概况"><div><strong>{shops.length.toString().padStart(2,'0')}</strong><span>统一选集<small>完成门店与榜单核验</small></span></div><div><strong>03</strong><span>透明权重维度<small>缺项按中性值并降低覆盖</small></span></div><div><strong>10</strong><span>深圳地区<small>地区只用于查找</small></span></div><div class="stat-date"><span>最近整理日期<strong>{catalogue.updatedAt}</strong></span><a href={pathFor('status/')}>查看资料状态 ↗</a></div></section>
  <section class="district-section shell"><div class="section-heading compact"><h2>按街区查看全部收录</h2><span>不设地区名额</span></div><div class="district-grid">{districts.map((d,i) => <a class="district-chip" href={`${pathFor()}?district=${encodeURIComponent(d)}#find`}><span class="district-number">{String(i+1).padStart(2,'0')}</span><strong>{d}</strong><span class="district-count">{shops.filter(s => s.district===d).length} 家 <span aria-hidden="true">↗</span></span></a>)}</div></section>
  <Catalog />
  <section class="principles shell"><div class="principles-intro"><div class="eyebrow">HOW WE KEEP IT HONEST</div><h2>高德给出原始资料，<br />本站统一整理。</h2><a href={pathFor('methodology/')}>读完整评分方法 ↗</a></div><div class="principle-items"><div><span>01</span><h3>同一选集，同一权重</h3><p>口碑45%、榜单35%、回访证据20%，名次不会随筛选条件重算。</p></div><div><span>02</span><h3>缺项不伪造</h3><p>缺失维度按中性50计入，同时降低资料覆盖；覆盖率不是置信概率。</p></div><div><span>03</span><h3>原始来源可回查</h3><p>分数是本站选集内的整理参考，不是高德官方排名或美味的客观测量。</p></div></div></section>
</Layout>
